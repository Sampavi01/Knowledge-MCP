{
    "mcpServers": {
        
        "filesystem": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "."
            ],
            "env": null
        },
        
        "research": {
            "command": "uv",
            "args": ["run", "mcp_server.py"],
            "env": null
        },
        
        "fetch": {
            "command": "uvx",
            "args": ["mcp-server-fetch"],
            "env": null
        }
    }
}